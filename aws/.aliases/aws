# Print output directly instead of opening a pager
export AWS_PAGER=''

alias awswho='aws sts get-caller-identity'

# Profile names, for awsp and its completion. AWS_PROFILE is dropped so a stale one cannot make the lookup fail.
function _aws_profiles { env -u AWS_PROFILE aws configure list-profiles 2>/dev/null ; }

# awsp sets the AWS profile for this shell; with no argument it clears it
function awsp {
  if [ -z "$1" ]; then
    unset AWS_PROFILE
    return
  fi
  _aws_profiles | grep -qxF -- "$1" || { echo "awsp: no such profile: $1" >&2; return 1; }
  export AWS_PROFILE="$1"
}
