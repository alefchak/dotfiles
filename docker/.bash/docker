command -v docker >/dev/null 2>&1 && {
    eval "$(docker completion bash)"
    function _dbash { COMPREPLY=($(compgen -W "$(docker ps --format '{{.Names}}' 2>/dev/null)" -- "${COMP_WORDS[COMP_CWORD]}")) ; }
    function _dvbackup { COMPREPLY=($(compgen -W "$(docker volume ls --format '{{.Name}}' 2>/dev/null)" -- "${COMP_WORDS[COMP_CWORD]}")) ; }
    complete -F _dbash dbash
    complete -F _dvbackup dvbackup
}
