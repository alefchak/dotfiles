alias fga='flux get all -A'
alias fgk='flux get kustomizations -A'
alias fgh='flux get helmreleases -A'
alias frk='flux reconcile kustomization --with-source'
alias frh='flux reconcile helmrelease --with-source --force'
alias frs='flux reconcile source git'

# Kustomizations and helmreleases a kustomization applied, from its inventory, as "kind name namespace" lines
function _flux_children {
  local json
  json=$(kubectl get kustomizations.kustomize.toolkit.fluxcd.io "$1" -n "$2" -o json) || return 1
  jq -r <<< "$json" '
    .status.inventory.entries[]?.id | split("_")
    | select(.[2:] == ["kustomize.toolkit.fluxcd.io", "Kustomization"] or .[2:] == ["helm.toolkit.fluxcd.io", "HelmRelease"])
    | "\(.[3] | ascii_downcase) \(.[1]) \(.[0])"'
}

# Reconcile a kustomization and everything beneath it, parents first.
# Each kustomization's children come from its inventory after it reconciles, so anything deleted is recreated before it is visited.
function frtree {
  local root=flux-system rootns=flux-system item kind name ns todo children seen nl=$'\n' count=0 failed="" usage="usage: frtree [kustomization] [-n namespace]"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--namespace) rootns=$2; shift ;;
      --namespace=*) rootns=${1#*=} ;;
      -*) echo "$usage" >&2; return 1 ;;
      *) root=$1 ;;
    esac
    [ $# -gt 0 ] && shift
  done
  [ -n "$rootns" ] || { echo "$usage" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo "frtree: jq is required" >&2; return 1; }
  flux reconcile kustomization "$root" -n "$rootns" --with-source || return 1
  todo=$(_flux_children "$root" "$rootns") || return 1
  seen=$'\n'"kustomization $root $rootns"$'\n'
  # depth first: a kustomization's children go to the front of the list
  while [ -n "$todo" ]; do
    item=${todo%%$'\n'*}
    if [ "$item" = "$todo" ]; then todo=""; else todo=${todo#*$'\n'}; fi
    case "$seen" in *$'\n'"$item"$'\n'*) continue ;; esac
    seen="$seen$item"$'\n'
    read -r kind name ns <<< "$item"
    count=$((count + 1))
    if [ "$kind" = helmrelease ]; then
      flux reconcile helmrelease "$name" -n "$ns" --with-source || failed="$failed"$'\n'"  $kind $ns/$name"
    elif flux reconcile kustomization "$name" -n "$ns" && children=$(_flux_children "$name" "$ns"); then
      [ -n "$children" ] && todo="$children${todo:+$nl$todo}"
    else
      failed="$failed"$'\n'"  $kind $ns/$name (not descended into)"
    fi
  done
  if [ -n "$failed" ]; then
    echo "frtree: some of the $count resources under $root failed:$failed" >&2
    return 1
  fi
  echo "frtree: reconciled $root and $count resources under it"
}

# Reconcile the chain of kustomizations that own a helmrelease or kustomization, root first, then the target
function fra {
  local kind="" name="" ns=flux-system chain flag force last count=0 usage="usage: fra helmrelease|kustomization <name> [-n namespace]"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--namespace) ns=$2; shift ;;
      --namespace=*) ns=${1#*=} ;;
      -*) echo "$usage" >&2; return 1 ;;
      *) if [ -z "$kind" ]; then kind=$1; elif [ -z "$name" ]; then name=$1; else echo "$usage" >&2; return 1; fi ;;
    esac
    [ $# -gt 0 ] && shift
  done
  case "$kind" in
    hr|helmrelease) kind=HelmRelease ;;
    ks|kustomization) kind=Kustomization ;;
    *) kind="" ;;
  esac
  [ -n "$kind" ] && [ -n "$name" ] && [ -n "$ns" ] || { echo "$usage" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo "fra: jq is required" >&2; return 1; }
  chain=$(kubectl get kustomizations.kustomize.toolkit.fluxcd.io,helmreleases.helm.toolkit.fluxcd.io -A -o json |
    jq -r --arg start "$kind/$ns/$name" '
      def key: "\(.kind)/\(.metadata.namespace)/\(.metadata.name)";
      def owner: .metadata.labels // {}
        | if .["kustomize.toolkit.fluxcd.io/name"]
          then "Kustomization/\(.["kustomize.toolkit.fluxcd.io/namespace"])/\(.["kustomize.toolkit.fluxcd.io/name"])"
          else null end;
      (.items | map({key: key, value: .}) | from_entries) as $all
      | if $all[$start] then . else "fra: \($start) not found\n" | halt_error end
      # follow the owner labels up, root first; stop at the root (which owns itself), a missing owner or a cycle
      | def parent: .[0] as $k | $all[$k] | owner;
        [$start] | until(parent as $o | $o == null or $all[$o] == null or any(.[]; . == $o); [parent] + .)
      | map($all[.])
      # a kustomization gets --with-source only the first time its source appears in the chain;
      # a helmrelease can only be the target, which is forced
      | reduce .[] as $o ({seen: [], rows: []};
          if $o.kind == "HelmRelease" then
            .rows += [["helmrelease", $o.metadata.name, $o.metadata.namespace, "--with-source", "--force"]]
          else
            ($o.spec.sourceRef | "\(.kind)/\(.namespace // $o.metadata.namespace)/\(.name)") as $src
            | .rows += [["kustomization", $o.metadata.name, $o.metadata.namespace]
                        + (if any(.seen[]; . == $src) then [] else ["--with-source"] end)]
            | .seen += [$src]
          end)
      | .rows[] | @tsv') || return 1
  while read -r kind name ns flag force; do
    # shellcheck disable=SC2086 # unquoted so that an empty flag is dropped
    flux reconcile "$kind" "$name" -n "$ns" $flag $force || { echo "fra: stopped at $kind $ns/$name" >&2; return 1; }
    count=$((count + 1)); last="$kind $ns/$name"
  done <<< "$chain"
  echo "fra: reconciled $count resources, ending with $last"
}

# Names of a flux resource type in one namespace, for completion
function _flux_names { kubectl get "$1" -n "$2" --no-headers -o custom-columns=:metadata.name 2>/dev/null ; }
