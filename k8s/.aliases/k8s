alias k='kubectl'
alias kcl='kubectl config get-contexts'
alias kcu='kubectl config use-context'
alias kgetfailed='kubectl get pods --field-selector="status.phase!=Succeeded,status.phase!=Running"'
alias kdeletefailed='kubectl delete pods --field-selector="status.phase!=Succeeded,status.phase!=Running"'

# Debug with netshoot: kdebug <pod> --target=<container>, kdebug <pod> --copy-to=<name>, kdebug node/<node>
alias kdebug='kubectl debug -it --image=nicolaka/netshoot --profile=netadmin'
# A throwaway netshoot pod, deleted on exit
alias knetshoot='kubectl run netshoot --rm -it --restart=Never --image=nicolaka/netshoot'

# Namespace names, for completion
function _kube_namespaces { kubectl get namespaces --no-headers -o custom-columns=:metadata.name 2>/dev/null ; }

# kns sets the namespace of the current context; with no argument it prints it
function kns {
  local ns err
  if [ -z "$1" ]; then
    ns=$(kubectl config view --minify -o jsonpath='{..namespace}') || return 1
    echo "${ns:-default}"
    return
  fi
  # refuse only a namespace the cluster says is missing, so it still works without access to namespaces
  err=$(kubectl get namespace "$1" -o name 2>&1 >/dev/null)
  case "$err" in *NotFound*) echo "kns: no such namespace: $1" >&2; return 1 ;; esac
  kubectl config set-context --current --namespace="$1" >/dev/null
}

function kgetall {
  [ -n "$1" ] || { echo "usage: kgetall <namespace>" >&2; return 1; }
  for i in $(kubectl api-resources --verbs=list --namespaced -o name | grep -v "events" | sort -u); do
    echo "Resource: $i"
    kubectl -n "$1" get --ignore-not-found "$i" --sort-by=.metadata.creationTimestamp
  done
}
